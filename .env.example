# coderX — copy to .env.local and fill in.
# Without these the app still works: Bolt falls back to handwritten hints.

OPENROUTER_API_KEY=
TUTOR_MODEL=anthropic/claude-haiku-4.5
# ~$0.001 per hint, so 200/day is roughly 20-30 cents. Best-effort only:
# serverless instances don't share this counter. The daily limit on the
# OpenRouter key itself is the real backstop, and hitting it degrades to the
# handwritten hints rather than breaking anything.
TUTOR_DAILY_CALL_CAP=200

# Optional: shown to OpenRouter for attribution/rankings.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=coderX

# PIN for the /grownups parent view (4+ digits). Defaults to 1234 if unset.
GROWNUP_PIN=1234
